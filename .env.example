# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
# Keep secrets in your local .env or Vercel environment settings.
# Do not commit real credentials to version control.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://afficixo.vercel.app
NEXT_PUBLIC_LANDING_PAGE_DOMAIN=weebly.pro

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Prisma reads DATABASE_URL only. For Neon/Vercel deployments, make sure
# your deployment environment exposes the connection string under DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&channel_binding=require"

# Landing pages and templates use a separate Prisma datasource.
# This can point to the same database or a dedicated landing database.
LANDING_DATABASE_URL="postgresql://user:password@host:5432/landing_database?sslmode=require&channel_binding=require"

# ──────────────────────────────────────────────
# Authentication - CHANGE IN PRODUCTION
# ──────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRY=2592000

# ──────────────────────────────────────────────
# Admin User
# ──────────────────────────────────────────────
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="your-admin-password"

# ──────────────────────────────────────────────
# Owner User
# Required so manager links can fall back to the shared owner offers.
# ──────────────────────────────────────────────
OWNER_USERNAME="your-owner-username"
OWNER_PASSWORD="your-owner-password"

# ──────────────────────────────────────────────
# Google OAuth (optional for Google auth flows)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"

# ──────────────────────────────────────────────
# IP2Location API
# ──────────────────────────────────────────────
# Use a single API key, or multiple comma-separated keys for round-robin failover.
IP2LOCATION_API_KEY="your-ip2location-api-key"
IP2LOCATION_API_KEYS="your-ip2location-api-key,another-api-key"

# GEO defaults and tuning
GEO_DEFAULT_COUNTRY="US"
GEO_ALLOW_LOCAL_IN_PROD=false
GEO_REQUEST_TIMEOUT=5000
GEO_IP2LOCATION_RETRIES=1

# ──────────────────────────────────────────────
# Duplicate click detection window
# ──────────────────────────────────────────────
CLICK_DEDUPE_WINDOW_MINUTES=10
CLICK_DEDUPE_WINDOW_MS=600000

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="https://afficixo.vercel.app"

# ──────────────────────────────────────────────
# Vercel Domain API
# Required if your website should add the custom domain alias through the app
# instead of only through the Vercel dashboard.
# ──────────────────────────────────────────────
VERCEL_TOKEN="your-vercel-token"
VERCEL_PROJECT_ID="your-vercel-project-id"
VERCEL_PROJECT_NAME="your-vercel-project-name"
VERCEL_TEAM_ID="team_OcaWDy4cOxiQJmiK6U6lDkOW"